@page "/"
@inject ApiService Api
@inject IJSRuntime JS

@if (!isAuth)
{
    <div class="login-wrap">
        <div class="card">
            <h2>買い物アプリ</h2>
            @if (!string.IsNullOrEmpty(errorMsg)) { <p class="error">@errorMsg</p> }
            <div class="form-group">
                <label>ユーザー名</label>
                <input @bind="username" type="text" placeholder="ユーザー名" autocomplete="username" />
            </div>
            <div class="form-group">
                <label>パスワード</label>
                <input @bind="password" type="password" placeholder="パスワード" />
            </div>
            @if (showRegister)
            {
                <div class="form-group">
                    <label>登録コード</label>
                    <input @bind="registerCode" type="password" placeholder="管理者から受け取ったコード" autocomplete="off" />
                </div>
                <button class="btn-primary btn-large" @onclick="Register">アカウントを作成</button>
                <button class="btn-sub" @onclick="ShowLogin">ログインに戻る</button>
            }
            else
            {
                <button class="btn-primary btn-large" @onclick="Login">ログイン</button>
                <button class="btn-sub" @onclick="ShowRegister">新規登録</button>
            }
        </div>
    </div>
}
else
{
    <div class="app">
        <div class="tab-bar">
            <button class="tab @(tab=="list"?"active":"")" @onclick="ShowList">買い物リスト</button>
            <button class="tab @(tab=="history"?"active":"")" @onclick="ShowHistory">履歴</button>
            <button class="tab @(tab=="add"?"active":"")" @onclick="ShowAdd">商品マスタ</button>
            <button class="tab-logout" @onclick="Logout">ログアウト</button>
        </div>

        @if (tab == "list")
        {
            <div class="header-row">
                <span class="count-text">@checkedCount / @totalCount 件</span>
                <button class="btn-sm" @onclick="ResetChecked">チェック済み削除</button>
                <button class="btn-sm" @onclick="DeleteAllItems">全削除</button>
                <button class="btn-primary" @onclick="CompleteShopping">買い物履歴登録</button>
            </div>
            <div class="progress-wrap">
                <div class="progress-bar" style="width:@progressPct%"></div>
            </div>

            @if (listItems == null)
            {
                <p class="loading">読み込み中...</p>
            }
            else if (!listItems.Any())
            {
                <p class="empty">リストに商品がありません</p>
            }
            else
            {
                @foreach (var item in listItems.Where(i => !i.IsChecked))
                {
                    var itemId = item.Id;
                    <div class="card item-card">
                        <div class="item-row">
                            <div class="check-circle" @onclick="() => ToggleItem(itemId)"></div>
                            <div class="item-info" style="flex:1">
                                <div class="item-name">@item.Name</div>
                                <div class="item-sub">
                                    <div class="quantity-control">
                                        <button class="quantity-btn" @onclick="() => ChangeQuantity(itemId, -1)">-</button>
                                        <span class="quantity-value">@item.Quantity</span>
                                        <button class="quantity-btn" @onclick="() => ChangeQuantity(itemId, 1)">+</button>
                                    </div>
                                    @item.Memo
                                </div>
                            </div>
                            <button class="btn-del" @onclick="() => DeleteItem(itemId)">×</button>
                        </div>
                    </div>
                }
                @if (listItems.Any(i => i.IsChecked))
                {
                    <hr class="divider" />
                    <p class="done-label">購入済み</p>
                    @foreach (var item in listItems.Where(i => i.IsChecked))
                    {
                        var itemId = item.Id;
                        <div class="card item-card">
                            <div class="item-row">
                                <div class="check-circle checked" @onclick="() => ToggleItem(itemId)"></div>
                                <div class="item-info">
                                    <div class="item-name done-text">@item.Name</div>
                                    <div class="item-sub">
                                        <div class="quantity-control">
                                            <button class="quantity-btn" @onclick="() => ChangeQuantity(itemId, -1)">-</button>
                                            <span class="quantity-value">@item.Quantity</span>
                                            <button class="quantity-btn" @onclick="() => ChangeQuantity(itemId, 1)">+</button>
                                        </div>
                                        @item.Memo
                                    </div>
                                </div>
                                <button class="btn-del" @onclick="() => DeleteItem(itemId)">×</button>
                            </div>
                        </div>
                    }
                }
            }
        }

        @if (tab == "history")
        {
            @if (!string.IsNullOrEmpty(historyMessage))
            {
                <div class="toast">@historyMessage</div>
            }
            @if (shoppingHistories == null)
            {
                <p class="loading">読み込み中...</p>
            }
            else if (!shoppingHistories.Any())
            {
                <p class="empty">履歴がありません</p>
            }
            else
            {
                @foreach (var h in shoppingHistories)
                {
                    var hId = h.Id;
                    <div class="card" style="margin-bottom:1rem;">
                        <div class="header-row">
                            <span class="item-name">@h.CompletedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                            <button class="btn-sm" @onclick="() => RestoreHistory(hId)">呼び出し</button>
                            <button class="btn-del" @onclick="() => DeleteHistory(hId)">×</button>
                        </div>
                        @foreach (var item in h.Items)
                        {
                            <div class="item-sub" style="margin-left:0.5rem;">
                                @item.Name @item.Quantity @item.Memo @(item.IsChecked ? "(購入済み)" : "")
                            </div>
                        }
                    </div>
                }
            }
        }

        @if (tab == "add")
        {
            @if (!string.IsNullOrEmpty(addMessage))
            {
                <div class="toast">@addMessage</div>
            }
            <div class="card">
                <p class="section-title">商品マスタ</p>
                <div class="form-group">
                    <label>商品名 *</label>
                    <input @bind="newName" type="text" placeholder="例：牛乳" />
                </div>
                <div class="form-group">
                    <label>メモ</label>
                    <textarea @bind="newMemo" placeholder="例：特売だったら2つ買って"></textarea>
                </div>
                <label class="check-label">
                    <input type="checkbox" @bind="addToShoppingList" /> 買い物リストに追加
                </label>
                <button class="btn-primary" @onclick="AddMasterItem">追加</button>
            </div>
            
            @if (masterItems != null && masterItems.Any())
            {
                <div class="card" style="margin-top:1rem;">
                    <p class="section-title">登録済み商品</p>
                    <div class="form-group">
                        <input @bind="searchQuery" type="text" placeholder="商品名で検索..." />
                    </div>
                    @foreach (var m in masterItems.Where(m => string.IsNullOrEmpty(searchQuery) || m.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
                    {
                        var mId = m.Id;
                        var mName = m.Name;
                        var mMemo = m.Memo;
                        <div class="card item-card" style="margin-bottom:0.5rem;">
                            <div class="item-info" style="margin-bottom: 10px;">
                                <div class="item-name">@m.Name</div>
                                @if (!string.IsNullOrEmpty(m.Memo))
                                {
                                    <div class="item-sub">@m.Memo</div>
                                }
                            </div>
                            <div class="item-row" style="justify-content: flex-end;">
                                <button class="btn-sm" @onclick="() => AddFromMaster(mName, mMemo)">+ リストへ</button>
                                <button class="btn-sm" @onclick="() => EditMasterItem(mId)">編集</button>
                                <button class="btn-del" @onclick="() => DeleteMaster(mId)">×</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
}

@code {
    string tab = "list";
    bool isAuth = false;
    bool showRegister = false;
    string username = "", password = "", registerCode = "", errorMsg = "";
    string newName = "", newMemo = "";
    string addMessage = "";
    string historyMessage = "";
    bool addToShoppingList = true;
    bool isEditingMaster = false;
    int editingMasterId = 0;
    string searchQuery = "";
    List<ShoppingItemModel>? listItems;
    List<MasterItemModel>? masterItems;
    List<ShoppingHistoryModel>? shoppingHistories;

    int totalCount => listItems?.Count ?? 0;
    int checkedCount => listItems?.Count(i => i.IsChecked) ?? 0;
    string progressPct => totalCount > 0 ? ((double)checkedCount / totalCount * 100).ToString("F0") : "0";

    // ── タブ切り替え（ラムダ内でawaitできないため専用メソッドに）──
    void ShowLogin()  { showRegister = false; errorMsg = ""; }
    void ShowRegister() { showRegister = true; errorMsg = ""; }
    async Task ShowList()   { tab = "list"; await LoadList(); }
    async Task ShowHistory() { tab = "history"; await LoadHistory(); }
    async Task ShowAdd()    { tab = "add"; await LoadMaster(); }

    protected override async Task OnInitializedAsync()
    {
        isAuth = await Api.IsAuthenticatedAsync();
        if (isAuth) await LoadList();
    }

    async Task Login()
    {
        errorMsg = "";
        var res = await Api.LoginAsync(new LoginRequest(username, password));
        if (res == null) { errorMsg = "ログインに失敗しました"; return; }
        isAuth = true;
        await LoadList();
    }

    async Task Register()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(registerCode)) { errorMsg = "登録コードを入力してください"; return; }
        var res = await Api.RegisterAsync(new RegisterRequest(username, password, registerCode));
        if (res == null) { errorMsg = "登録に失敗しました"; return; }
        isAuth = true;
        showRegister = false;
        await LoadList();
    }

    async Task Logout()
    {
        await Api.LogoutAsync();
        isAuth = false;
        listItems = null;
        username = password = registerCode = "";
    }

    async Task LoadList()
    {
        var res = await Api.GetListAsync();
        listItems = res?.Items ?? new List<ShoppingItemModel>();
    }

    async Task LoadMaster()
    {
        masterItems = await Api.GetMasterItemsAsync();
    }

    async Task ToggleItem(int id)
    {
        await Api.ToggleItemAsync(id);
        await LoadList();
    }

    async Task DeleteItem(int id)
    {
        await Api.DeleteItemAsync(id);
        await LoadList();
    }

    async Task ResetChecked()
    {
        await Api.ResetCheckedAsync();
        await LoadList();
    }

    async Task AddMasterItem()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        
        if (isEditingMaster)
        {
            await Api.UpdateMasterItemAsync(editingMasterId, new UpdateMasterItemRequest(newName, newMemo));
            addMessage = "商品を更新しました！";
            isEditingMaster = false;
            editingMasterId = 0;
        }
        else
        {
            await Api.AddMasterItemAsync(new AddMasterItemRequest(newName, newMemo));
            addMessage = "商品を登録しました！";
        }
        
        if (addToShoppingList)
        {
            await Api.AddItemAsync(new AddItemRequest(newName, "1", newMemo, false));
        }
        
        newName = newMemo = "";
        addToShoppingList = false;
        await LoadMaster();
        StateHasChanged();
        await Task.Delay(1500);
        addMessage = "";
    }

    async Task EditMasterItem(int id)
    {
        var item = masterItems?.FirstOrDefault(m => m.Id == id);
        if (item != null)
        {
            newName = item.Name;
            newMemo = item.Memo ?? "";
            isEditingMaster = true;
            editingMasterId = id;
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    async Task AddFromMaster(string name, string? memo)
    {
        await Api.AddItemAsync(new AddItemRequest(name, null, memo, false));
        addMessage = $"「{name}」をリストに追加しました！";
        StateHasChanged();
        await Task.Delay(1500);
        addMessage = "";
    }

    async Task DeleteMaster(int id)
    {
        await Api.DeleteMasterItemAsync(id);
        await LoadMaster();
    }

    async Task UpdateQuantity(int id, string quantity)
    {
        var item = listItems?.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
            await Api.UpdateItemAsync(id, new UpdateItemRequest(item.Name, quantity, item.Memo));
            await LoadList();
        }
    }

    async Task ChangeQuantity(int id, int delta)
    {
        var item = listItems?.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
            var currentQty = int.TryParse(item.Quantity, out var qty) ? qty : 1;
            var newQty = Math.Max(1, Math.Min(10, currentQty + delta));
            await Api.UpdateItemAsync(id, new UpdateItemRequest(item.Name, newQty.ToString(), item.Memo));
            await LoadList();
        }
    }

    async Task LoadHistory()
    {
        shoppingHistories = await Api.GetShoppingHistoriesAsync();
    }

    async Task CompleteShopping()
    {
        if (listItems == null || !listItems.Any()) return;
        
        var snapshots = listItems.Select(i => new ShoppingItemSnapshot(i.Name, i.Quantity, i.Memo, i.IsChecked)).ToList();
        await Api.CreateShoppingHistoryAsync(new CreateShoppingHistoryRequest(snapshots));
        
        await Api.ResetCheckedAsync();
        await LoadList();
        historyMessage = "買い物履歴を保存しました！";
        StateHasChanged();
        await Task.Delay(1500);
        historyMessage = "";
    }

    async Task RestoreHistory(int historyId)
    {
        await Api.RestoreShoppingHistoryAsync(historyId);
        await LoadList();
        historyMessage = "履歴を呼び出しました！";
        StateHasChanged();
        await Task.Delay(1500);
        historyMessage = "";
    }

    async Task DeleteAllItems()
    {
        await Api.DeleteAllItemsAsync();
        await LoadList();
    }

    async Task DeleteHistory(int historyId)
    {
        await Api.DeleteShoppingHistoryAsync(historyId);
        await LoadHistory();
    }
}
